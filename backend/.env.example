# Copy to backend/.env and adjust as needed.

# App
APP_NAME=AI Secretary Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true

# CORS: "*" allows all origins (dev), or comma-separated list
CORS_ORIGINS=*

# LLM (optional) — 없으면 템플릿으로 동작
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=8.0
